generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  metaConnection  MetaConnection?
  dashboardConfig DashboardConfig?

  // True only for admin@advertise4me.com (the agency owner) - see
  // lib/admin.ts's ensureAdminFlag(), which sets this idempotently at
  // login/signup. Grants access to assigning shared ad accounts to clients
  // (Phase A of the Business-Manager-system-user-token migration).
  isAdmin Boolean @default(false)

  // Shared Meta ad account(s) the agency owner has assigned to this user -
  // see AdAccountAssignment below. A user can have more than one; see
  // lib/adAccountAccess.ts for how the app currently picks which one to use.
  adAccountAssignments AdAccountAssignment[]

  // --- Settings (Phase 5a) --------------------------------------------
  fullName        String?
  businessName    String?
  businessWebsite String?
  // "en" | "es" - stored only, no translation work done yet (see Settings
  // 6.1 Language preference).
  language        String           @default("en")

  // Optional monthly spend cap (Settings 6.4). Stored only in this phase -
  // nothing currently reads or enforces it; see Settings 6.4 in the Phase 5a
  // report for what a future phase would need to wire this up to.
  monthlySpendCap Float?

  // Email notification preferences (Settings 6.5). Push is not built yet -
  // see components/dashboard/settings/NotificationsSection.tsx.
  notifyWeeklySummary  Boolean @default(true)
  notifyNeedsAttention Boolean @default(true)
  notifyMetaAccessLost Boolean @default(true)

  emailChangeTokens   EmailChangeToken[]
  passwordResetTokens PasswordResetToken[]
}

// Single-use, short-expiry token proving control of a NEW email address
// before User.email actually changes (Settings 6.2 "Change email"). The
// email only changes once the link built from this token is visited - see
// app/api/auth/verify-email-change/route.ts.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use, short-expiry token for the "forgot password" flow (Settings
// 6.2 / the logged-out login page) - see
// app/api/auth/{forgot-password,reset-password}/route.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A Meta ad account (shared with advertise4me's Business Portfolio by the
// client, outside this app) manually assigned by the admin to exactly one
// user at a time - adAccountId is UNIQUE, so no two users can ever be
// handed the same ad account. userId null means the account is visible to
// the Business Manager system user token but not yet assigned to anyone.
// One user can hold multiple assignments (one-to-many from User). There is
// no per-account access token here - every Meta API call for every user
// uses the single process.env.META_SYSTEM_USER_TOKEN (see
// lib/adAccountAccess.ts). This is the Phase A replacement for the old
// per-user MetaConnection flow below, which is left in place but orphaned.
model AdAccountAssignment {
  id            String    @id @default(cuid())
  adAccountId   String    @unique
  adAccountName String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedAt    DateTime  @default(now())
  // The admin user's id who made this assignment. Not a foreign key - purely
  // an audit field, same convention as WriteActionLog.userId below.
  assignedBy    String?

  @@index([userId])
}

// One connected Meta ad account per user. The access token is encrypted at
// rest (AES-256-GCM, see lib/crypto.ts) - the raw token never touches the
// database in plaintext, same guarantee the old cookie-only design had.
model MetaConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccountId           String
  accountName           String?
  currency              String?
  accessTokenCiphertext String
  // The Facebook Page ads are posted as - required to create ad creatives.
  // Auto-detected from the token's linked pages at connect time; null if
  // the token has no linked page yet, or (when more than one was found)
  // until the user picks one.
  facebookPageId        String?
  facebookPageName      String?
  // Business portfolio the ad account belongs to, if the Graph API reports
  // one for this token (Settings 6.3 "Connected accounts"). Null if the
  // account isn't under a Business Manager / the token can't see it.
  businessId            String?
  businessPortfolioName String?
  // Updated by app/api/summary/route.ts on every summary load - "ok" right
  // after a successful Meta call, "error" when that call fails with an
  // expired/invalid token. Drives the status dot and "last sync" time in
  // Settings 6.3 without Settings itself having to call Meta.
  lastSyncAt            DateTime?
  lastSyncStatus        String?
  // Throttle for the "Meta access lost" email alert (Settings 6.5) - set
  // when that alert is actually sent, so a flaky/retried request doesn't
  // re-send it every time.
  lastAccessLostAlertAt DateTime?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// The AI Summary tab's per-user business-type classification (see
// lib/kpiConfig.ts), auto-detected from the connected ad account's campaign
// objectives and action types the first time the summary is loaded, and
// cached here so the tab doesn't re-detect (and potentially flip-flop) on
// every request. businessType is one of lib/kpiConfig.ts's BusinessType
// values. targetValue/primaryKpi are blank until Settings (Phase 5) lets the
// user set a goal; detection can be overridden there once that UI exists.
model DashboardConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType String
  primaryKpi   String?
  targetValue  Float?
  currency     String?
  detectedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Throttle for the "Needs attention" email alert (Settings 6.5) - set
  // when that alert is actually sent, so repeated summary loads while the
  // account is still in "attention" status don't re-send it every time.
  lastAttentionAlertAt DateTime?
}

// Audit trail of Meta write actions actually executed through the
// confirm-action flow (see app/api/meta/confirm-action/route.ts). Write
// tool calls that are only proposed and never confirmed are not logged
// here - this table is only ever written to right after a real Meta API
// call succeeds or fails.
model WriteActionLog {
  id        String   @id @default(cuid())
  userId    String
  tool      String
  summary   String
  input     String
  status    String
  result    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Spend-approval log (Phase 3): one row per user approval of a
// spendAffecting write action - a create or budget change on a
// campaign/ad set (see lib/metaWriteGate.ts's spendAffecting flag).
// Written by app/api/meta/confirm-action/route.ts right after a successful
// Meta call, additive to WriteActionLog above (which still logs every write
// action, spend-affecting or not) - not a replacement for it. termsVersion
// is the real current Terms of Service version (lib/legal.ts's
// getCurrentTermsVersion()) as of Phase 5b - see TermsAcceptance below for
// the clickwrap that actually records a user's agreement to that version.
model AdActionApproval {
  id           String   @id @default(cuid())
  userId       String
  tool         String
  objectId     String?
  budget       String?
  termsVersion String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ad_action_approvals")
}

// One row per terms-acceptance event (Phase 5b clickwrap): a user agreeing
// to the Terms of Service / Ad Spend & Media Buying Disclaimer at a given
// content version (see lib/legal.ts). Written on first sign-up, before the
// user can connect a Meta account (app/api/legal/accept/route.ts), and
// again whenever the content version changes and the user re-accepts
// (app/(dashboard)/layout.tsx's version-mismatch gate -> app/accept-terms).
// This is an append-only audit log, not a toggle - a user's "current"
// acceptance is whichever row has the latest acceptedAt.
model TermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  termsVersion String
  acceptedAt   DateTime @default(now())
  // Best-effort only - whatever the request headers happen to carry, not a
  // verified identity signal.
  ipAddress    String?
  userAgent    String?

  @@index([userId, acceptedAt])
  @@map("terms_acceptances")
}
