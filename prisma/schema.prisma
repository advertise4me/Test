generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  metaConnection  MetaConnection?
  dashboardConfig DashboardConfig?
}

// One connected Meta ad account per user. The access token is encrypted at
// rest (AES-256-GCM, see lib/crypto.ts) - the raw token never touches the
// database in plaintext, same guarantee the old cookie-only design had.
model MetaConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccountId           String
  accountName           String?
  currency              String?
  accessTokenCiphertext String
  // The Facebook Page ads are posted as - required to create ad creatives.
  // Auto-detected from the token's linked pages at connect time; null if
  // the token has no linked page yet, or (when more than one was found)
  // until the user picks one.
  facebookPageId        String?
  facebookPageName      String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// The AI Summary tab's per-user business-type classification (see
// lib/kpiConfig.ts), auto-detected from the connected ad account's campaign
// objectives and action types the first time the summary is loaded, and
// cached here so the tab doesn't re-detect (and potentially flip-flop) on
// every request. businessType is one of lib/kpiConfig.ts's BusinessType
// values. targetValue/primaryKpi are blank until Settings (Phase 5) lets the
// user set a goal; detection can be overridden there once that UI exists.
model DashboardConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType String
  primaryKpi   String?
  targetValue  Float?
  currency     String?
  detectedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Audit trail of Meta write actions actually executed through the
// confirm-action flow (see app/api/meta/confirm-action/route.ts). Write
// tool calls that are only proposed and never confirmed are not logged
// here - this table is only ever written to right after a real Meta API
// call succeeds or fails.
model WriteActionLog {
  id        String   @id @default(cuid())
  userId    String
  tool      String
  summary   String
  input     String
  status    String
  result    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
